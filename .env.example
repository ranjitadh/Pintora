# Used by docker compose and the container builds.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SERVE_MEDIA=true

POSTGRES_DB=printora
POSTGRES_USER=printora
POSTGRES_PASSWORD=printora
DATABASE_URL=postgres://printora:printora@db:5432/printora

SITE_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

CELERY_TASK_ALWAYS_EAGER=false
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
MAX_UPLOAD_BYTES=15728640
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=20/min
THROTTLE_UPLOAD=60/hour

DJANGO_ADMIN_EMAIL=admin@printora.local
DJANGO_ADMIN_PASSWORD=change-this-admin-password
DEMO_CUSTOMER_EMAIL=demo@printora.local
DEMO_CUSTOMER_PASSWORD=change-this-demo-password

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_WEBHOOK_SECRET=

# Server-side backend origin used by Next.js /api and /media rewrites.
# Inside Docker this is the compose service name; use http://localhost:8000
# only when running the frontend outside Compose.
NEXT_PUBLIC_BACKEND_ORIGIN=http://backend:8000
