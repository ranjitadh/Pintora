# Browser-facing API prefix. Keep /api so requests go through the Next proxy.
NEXT_PUBLIC_API_URL=/api

# Server-side target for /api and /media rewrites.
NEXT_PUBLIC_BACKEND_ORIGIN=http://127.0.0.1:8000

# Optional server-only backend origin for SSR. Defaults to NEXT_PUBLIC_BACKEND_ORIGIN.
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Absolute storefront URL used in canonical, Open Graph and JSON-LD metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
