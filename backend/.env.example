# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SERVE_MEDIA=true

# Optional PostgreSQL. Leave unset to use backend/db.sqlite3.
# DATABASE_URL=postgres://printora:printora@localhost:5432/printora

# URLs
SITE_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery. Leave unset / eager=true to run jobs inline in development.
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Tokens and limits
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
MAX_UPLOAD_BYTES=15728640
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=20/min
THROTTLE_UPLOAD=60/hour

# Demo seed (only read by `manage.py seed_demo`)
DJANGO_ADMIN_EMAIL=admin@printora.local
DJANGO_ADMIN_PASSWORD=change-this-admin-password
DEMO_CUSTOMER_EMAIL=demo@printora.local
DEMO_CUSTOMER_PASSWORD=change-this-demo-password

# Shopify (optional)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_WEBHOOK_SECRET=

# AI Assistant (MerchPress Assistant) - Deepseek configuration
# Set AI_PROVIDER=openai for Deepseek (OpenAI-compatible API)
AI_PROVIDER=openai
AI_API_KEY=sk-6f099f2e8bb54a6382b756df0b739f38
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=400
